NODE_ENV=development
PORT=3001
# Number of reverse-proxy hops directly in front of Express.
# Keep 1 for Nginx. Use 2 only if Express directly receives a two-proxy X-Forwarded-For chain.
TRUST_PROXY_HOPS=1
SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cuegrove
DB_PASSWORD=replace_with_a_database_password
DB_NAME=cuegrove
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace_with_at_least_32_random_characters
TURNSTILE_SECRET=
COOKIE_NAME=cuegrove_admin
COOKIE_SECURE=false
COOKIE_DOMAIN=

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_AUTH_REQUIRED=true
SMTP_TIMEOUT_MS=20000
SMTP_HELO_NAME=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CueGrove <earlyaccess@example.com>
SMTP_REPLY_TO=

PASSWORD_RESET_MINUTES=30
